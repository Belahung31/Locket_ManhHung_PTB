#!url=https://raw.githubusercontent.com/Belahung31/Locket_ManhHung_PTB/main/modules/ManhHung_FULL_v20.sgmodule
#!name=Locket Mạnh Hùng FULL v20.2 - PTB Caption RevenueCat
#!desc=PTB, Caption, RevenueCat, Debug tuy chinh trong Arguments; khong gia lap Gold.
#!author=ManhHung
#!system=ios
#!arguments=PTB_KEY:SET_YOUR_KEY,PTB:true,Caption:true,RevenueCat:true,Debug:false
#!arguments-desc=- PTB_KEY: Khoa Worker, chi nhap tren iPhone\n- PTB: Bat/tat 6 khung PTB [true, false]\n- Caption: Bat/tat 239 caption [true, false]\n- RevenueCat: Bat/tat chong cache va kiem tra response [true, false]\n- Debug: Bat/tat nhat ky script [true, false]\n- Mac dinh: PTB=true, Caption=true, RevenueCat=true, Debug=false; khong tao Gold.

[Rule]
AND,((DOMAIN,firebaseremoteconfig.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.locketcamera.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.revenuecat.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,us-central1-locket-4252a.cloudfunctions.net),(PROTOCOL,UDP)),REJECT

[Script]
MH20 Clear Firebase Cache = type=http-request,pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+$,script-path=https://raw.githubusercontent.com/Belahung31/Locket_ManhHung_PTB/main/scripts/ptb/v20/cache-with-options.js,argument=PTB={{{PTB}}}&Caption={{{Caption}}}&RevenueCat={{{RevenueCat}}}&Debug={{{Debug}}},timeout=20
MH20 RevenueCat Delete Header = type=http-request,pattern=^https?:\/\/api\.revenuecat\.com\/.+\/(?:receipts|subscribers)(?:\/|\?|$),requires-body=0,script-path=https://raw.githubusercontent.com/Belahung31/Locket_ManhHung_PTB/main/scripts/ptb/v20/revenuecat-request-with-options.js,argument=RevenueCat={{{RevenueCat}}}&Debug={{{Debug}}},timeout=30
MH20 Clear Locket Cache = type=http-request,pattern=^https?:\/\/api\.locketcamera\.com\/.+$,script-path=https://raw.githubusercontent.com/Belahung31/Locket_ManhHung_PTB/main/scripts/ptb/v20/cache-with-options.js,argument=PTB={{{PTB}}}&Caption={{{Caption}}}&RevenueCat={{{RevenueCat}}}&Debug={{{Debug}}},timeout=20
MH20 Firebase Remote Config = type=http-response,pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+$,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/Belahung31/Locket_ManhHung_PTB/main/scripts/ptb/v20/response-with-options.js,argument=PTB={{{PTB}}}&Caption={{{Caption}}}&RevenueCat={{{RevenueCat}}}&Debug={{{Debug}}},timeout=45
MH20 Locket API Response = type=http-response,pattern=^https?:\/\/api\.locketcamera\.com\/.+$,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/Belahung31/Locket_ManhHung_PTB/main/scripts/ptb/v20/response-with-options.js,argument=PTB={{{PTB}}}&Caption={{{Caption}}}&RevenueCat={{{RevenueCat}}}&Debug={{{Debug}}},timeout=45
MH20 RevenueCat Response = type=http-response,pattern=^https?:\/\/api\.revenuecat\.com\/.+\/(?:receipts(?:\?.*)?$|subscribers\/[^/?]+(?:\?.*)?$),requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/Belahung31/Locket_ManhHung_PTB/main/scripts/ptb/v20/revenuecat-response-with-options.js,argument=RevenueCat={{{RevenueCat}}}&Debug={{{Debug}}},timeout=30
MH20 Generate Own PTB = type=http-request,pattern=^https?:\/\/(?:api\.locketcamera\.com|us-central1-locket-4252a\.cloudfunctions\.net)\/generateFilteredImage(?:\?.*)?$,requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/Belahung31/Locket_ManhHung_PTB/main/scripts/ptb/v20/render-with-options.js,argument=PTB_KEY={{{PTB_KEY}}}&PTB={{{PTB}}}&Debug={{{Debug}}},timeout=40

[MITM]
hostname = %APPEND% api.locketcamera.com, firebaseremoteconfig.googleapis.com, api.revenuecat.com, us-central1-locket-4252a.cloudfunctions.net
